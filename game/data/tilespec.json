  "legend_map": {
    "g": ["grass1", "grass2", "grass3"],
    "G": ["grass_deco"],
    "d": ["dirt"],
    "p": ["street"],
    "s": ["sand"],
    "w": ["water"],
    "t": ["grass_auto", "tree"],
    "T": ["grass_auto", "tree_dense"],
    "W": ["street", "wall"],
    "E": ["street"],
    "h": ["street", "house"],
    "H": ["street", "tavern"],
    "f": ["farmland"],
    "F": ["grass_auto", "fence"],
    "Z": ["grass_auto", "zhai"],
    "r": ["grass_auto", "ruins"],
    "x": ["grass_auto"]
  },
  "notes": "legend_map 值 = [ground_tile] 或 [ground_tile, deco_tile]。grass_auto 表示按邻接随机取 grass1/2/3。水边沙、沙边草不做自动过渡块，靠 decoration 层撒 reed/tuft 软化边界。"
}
