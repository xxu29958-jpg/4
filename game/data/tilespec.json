{
  "atlas": "assets/tiles/tileset.png",
  "tile_size": 64,
  "columns": 8,
  "tiles": {
    "grass1":   {"xy": [0, 0], "layer": "ground", "collision": false},
    "grass2":   {"xy": [1, 0], "layer": "ground", "collision": false},
    "grass3":   {"xy": [2, 0], "layer": "ground", "collision": false},
    "dirt":     {"xy": [3, 0], "layer": "ground", "collision": false},
    "street":   {"xy": [4, 0], "layer": "ground", "collision": false},
    "sand":     {"xy": [5, 0], "layer": "ground", "collision": false},
    "water":    {"xy": [6, 0], "layer": "ground", "collision": true},
    "grass_deco": {"xy": [7, 0], "layer": "ground", "collision": false},
    "tree":     {"xy": [0, 1], "layer": "deco",   "collision": true},
    "tree_dense": {"xy": [1, 1], "layer": "deco", "collision": true},
    "wall":     {"xy": [2, 1],   "layer": "deco", "collision": true},
    "house":    {"xy": [3, 1],   "layer": "deco", "collision": true},
    "tavern":   {"xy": [4, 1],   "layer": "deco", "collision": true},
    "farmland": {"xy": [5, 1],   "layer": "ground", "collision": false},
    "fence":    {"xy": [6, 1],   "layer": "deco", "collision": true},
    "zhai":     {"xy": [7, 1],   "layer": "deco", "collision": true},
    "ruins":    {"xy": [0, 2],   "layer": "deco", "collision": true},
    "reed":     {"xy": [1, 2],   "layer": "deco", "collision": false},
    "tuft1":    {"xy": [2, 2],   "layer": "deco", "collision": false},
    "tuft2":    {"xy": [3, 2],   "layer": "deco", "collision": false},
    "stone":    {"xy": [4, 2],   "layer": "deco", "collision": false},
    "flower":   {"xy": [5, 2],   "layer": "deco", "collision": false},
    "sign":     {"xy": [6, 2],   "layer": "deco", "collision": false},
    "campfire": {"xy": [7, 2],   "layer": "deco", "collision": false}
